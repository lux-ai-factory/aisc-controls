# Postgres — defaults match the bundled docker-compose.yml so `npm run dev`
# can spin up a fresh DB for you. Override if you have your own Postgres.
#
# Every project has a database of its own, made by the platform; this is a
# template, and {database} is replaced with the project's database name
# (project_<pid without hyphens>). Keep connection_limit=2: the app keeps at
# most 20 project databases open, so that is at most 40 connections.
PROJECT_DATABASE_URL="postgresql://aisc:aisc@localhost:5444/{database}?schema=controls&connection_limit=2"

# The AISC platform, which says who is in a project and what they may do.
# Without it every project page answers 503: failing open is not an option.
PLATFORM_URL=""

# PDF report renderer (bundled services/pdf_renderer). The submission
# "Download report (PDF)" action POSTs to this service. The default matches the
# bundled docker-compose.yml; override only if you run the renderer elsewhere.
PDF_RENDERER_URL="http://localhost:8005"

# Feature flags. Set to "true" to enable.
#   AISC_ENABLE_TEMPLATE_EDITOR — exposes the per-checklist "Edit template"
#     action on the library page (checklists/[id]/review). Hidden by default;
#     for administrators only: the link, the page and the save refuse
#     anybody else, whatever their role in the project.
AISC_ENABLE_TEMPLATE_EDITOR=""

# The ledger cites the request the gateway witnessed (X-AISC-Request-Id) only
# when the request carries a gateway token that verifies against the realm
# (src/vendor/aisc-ledger/gatewayToken.ts). AUTH_ENABLED=false keeps the presented id
# unverified (local work); with it on (the default) and no issuer or JWKS URL,
# no request id is cited.
# AUTH_ENABLED="true"
# KEYCLOAK_ISSUER="http://localhost:8081/realms/aisc"
# KEYCLOAK_JWKS_URL="http://keycloak:8080/realms/aisc/protocol/openid-connect/certs"
# AISC_GATEWAY_CLIENT_ID="aisc-gateway"
