# Environment of controls-migrate and controls-web in the aisc stack (env_file
# in the aisc repo's docker-compose.development.yml, which adds the rest).
# Hosts are compose service names on the `backend` network, not localhost.
# For standalone development, use .env (see .env.example) instead.

# Every project has its own database, made by the platform. {database} is
# filled with that project's, from the /p/{pid} path; see src/lib/projectDb.ts.
PROJECT_DATABASE_URL=postgresql://controls_rw:controls_rw@postgres:5432/{database}?schema=controls&connection_limit=2

# The PDF report renderer, the controls-pdf service.
PDF_RENDERER_URL=http://controls-pdf:8005

# Hidden by default; set to "true" to expose the per-checklist template editor.
AISC_ENABLE_TEMPLATE_EDITOR=

# Tells scripts/setup-once.mjs to skip the standalone setup: the stack owns
# Postgres, and controls-migrate migrates the project databases.
AISC_PLATFORM=1

# Where projects are chosen. Reached without one, this app sends the reader
# there rather than asking a second time.
LAUNCHER_URL=http://localhost:8100/
