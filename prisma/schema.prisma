generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  Draft
  Closed
}

model Source {
  id         String      @id @default(cuid())
  slug       String      @unique
  name       String      @unique
  citation   String?
  url        String?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  checklists Checklist[]

  @@map("source")
}

model Checklist {
  id              String       @id @default(cuid())
  // Slug of the catalogue control this was installed from. Unique: this
  // database is one project, so a checklist is installed in it at most once.
  catalogueId     String?      @unique
  title           String
  sourceId        String
  source          Source       @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceUpdatedAt DateTime?    @map("source_updated_at") @db.Timestamptz(3)
  countryIds      String[]     @default([])
  regulationIds   String[]     @default([])
  controlTopic    String
  description     String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  questions       Question[]
  submissions     Submission[]

  @@index([sourceId])
  @@map("checklist")
}

model Question {
  id          String             @id @default(cuid())
  checklistId String
  order       Int
  text        String
  article     String?
  category    String?
  checklist   Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  answers     SubmissionAnswer[]

  @@unique([checklistId, order])
  @@index([checklistId])
  @@map("checklist_question")
}

model Submission {
  id                String             @id @default(cuid())
  checklistId       String
  label             String
  status            SubmissionStatus   @default(Draft)
  version           Int                @default(1)
  previousVersionId String?            @unique
  closedAt          DateTime?          @map("closed_at") @db.Timestamptz(3)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  checklist         Checklist          @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  previousVersion   Submission?        @relation("SubmissionVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersion       Submission?        @relation("SubmissionVersionChain")
  answers           SubmissionAnswer[]

  @@index([checklistId])
  @@index([status])
  @@index([archivedAt])
  @@map("submission")
}

model SubmissionAnswer {
  id           String     @id @default(cuid())
  submissionId String
  questionId   String
  answer       String?
  score        Int?
  /// The AI card version (core.system) that was the latest when this was answered.
  systemVersionPid    String?   @map("system_version_pid") @db.Uuid
  systemVersionNumber Int?      @map("system_version_number")
  answeredAt          DateTime? @map("answered_at") @db.Timestamptz(3)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@map("submission_answer")
}
